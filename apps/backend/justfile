# Backend workspace tasks (run from repo root via `just backend <task>`)
set export

TEST_DATABASE_URL := env_var_or_default('ZKSYNC_LITE_SUNSET_TEST_DATABASE_URL', 'postgres://postgres:postgres@127.0.0.1:5432/zksync_lite_sunset_test')

list:
  @just --list

build:
  @cargo build --workspace --all-targets

test:
  @ZKSYNC_LITE_SUNSET__CORE__DATABASE__URL={{TEST_DATABASE_URL}} \
    ZKSYNC_LITE_SUNSET__CORE__DATABASE__AUTO_MIGRATE=true \
    cargo nextest run --workspace --all-targets --all-features --test-threads 1

test-db-up:
  #!/usr/bin/env bash
  set -euo pipefail
  docker compose -f ../../infra/compose.yml up -d postgres
  if ! docker compose -f ../../infra/compose.yml exec -T postgres \
      psql -U postgres -d postgres -tAc \
      "SELECT 1 FROM pg_database WHERE datname = 'zksync_lite_sunset_test'" | grep -q 1; then
    docker compose -f ../../infra/compose.yml exec -T postgres \
      psql -U postgres -d postgres -v ON_ERROR_STOP=1 \
      -c "CREATE DATABASE zksync_lite_sunset_test"
  fi

test-db-down:
  @docker compose -f ../../infra/compose.yml down --remove-orphans

fmt:
  @cargo fmt

fmt-check:
  @cargo fmt -- --check

clippy:
  @cargo clippy --workspace --all-targets --all-features -- -D warnings

clippy-fix:
  @cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged

check:
  @just fmt-check
  @just clippy

fix:
  @just fmt && just clippy-fix

server-run:
  @cargo run -p zksync-lite-sunset-server

server-dev:
  @RUST_LOG=info cargo run -p zksync-lite-sunset-server

# Rebuild from scratch to avoid accidentally running a stale binary.
server-dev-fresh:
  @cargo clean -p zksync-lite-sunset-server
  @RUST_LOG=info cargo run -p zksync-lite-sunset-server

server-image-build:
  @docker image rm -f zksync-lite-sunset-server:dev >/dev/null 2>&1 || true
  @docker build --no-cache -t zksync-lite-sunset-server:dev -f crates/zksync-lite-sunset-server/Dockerfile ../..

# Initialize database schema (uses server migrations)
db-init database_url:
  @cargo run -p zksync-lite-sunset-cli -- db-init --database-url {{database_url}}

# Import snapshot CSVs into postgres
import-snapshots database_url data_dir="data" chunk_size="5000" truncate="false":
  #!/usr/bin/env bash
  set -euo pipefail
  args=(--database-url "{{database_url}}" --data-dir "{{data_dir}}" --chunk-size "{{chunk_size}}")
  if [[ "{{truncate}}" == "true" ]]; then
    args+=(--truncate)
  fi
  cargo run -p zksync-lite-sunset-cli -- import-snapshots "${args[@]}"

# Materialize deterministic claim entries/proofs from imported snapshot tables
claims-materialize database_url snapshot_label="snapshot-manual":
  @cargo run -p zksync-lite-sunset-cli -- claims-materialize --database-url "{{database_url}}" --snapshot-label "{{snapshot_label}}"

# Compile real snapshot CSVs into an offline artifact directory without DB access
snapshots-compile data_dir out_dir snapshot_label="snapshot-artifact":
  #!/usr/bin/env bash
  set -euo pipefail
  repo_root="$(cd ../.. && pwd)"
  data_dir="{{data_dir}}"
  out_dir="{{out_dir}}"
  if [[ "${data_dir}" != /* ]]; then
    data_dir="${repo_root}/${data_dir}"
  fi
  if [[ "${out_dir}" != /* ]]; then
    out_dir="${repo_root}/${out_dir}"
  fi
  RUST_LOG="${SNAPSHOT_RUST_LOG:-info}" cargo run -p zksync-lite-sunset-cli -- snapshots-compile --data-dir "${data_dir}" --out-dir "${out_dir}" --snapshot-label {{snapshot_label}}

# Manual synthetic performance smoke test for the snapshot compiler
snapshots-perf-test:
  @cargo test --manifest-path Cargo.toml -p zksync-lite-sunset-snapshot --test perf -- --ignored --nocapture

# Criterion benches for snapshot compile/materialization hotspots
snapshots-bench bench_filter="":
  #!/usr/bin/env bash
  set -euo pipefail
  args=(--manifest-path Cargo.toml -p zksync-lite-sunset-snapshot --bench snapshot_compile)
  if [[ -n "{{bench_filter}}" ]]; then
    args+=("{{bench_filter}}")
  fi
  cargo bench "${args[@]}"

# Whole-command benchmark for the real-data compile path
snapshots-hyperfine data_dir="data" out_dir="/tmp/zksync-lite-sunset-hyperfine" snapshot_label="snapshot-hyperfine" warmup="1" runs="3":
  #!/usr/bin/env bash
  set -euo pipefail
  if ! command -v hyperfine >/dev/null 2>&1; then
    echo "hyperfine is not installed. Install it with: brew install hyperfine" >&2
    exit 1
  fi
  repo_root="$(cd ../.. && pwd)"
  data_dir="{{data_dir}}"
  out_dir="{{out_dir}}"
  if [[ "${data_dir}" != /* ]]; then
    data_dir="${repo_root}/${data_dir}"
  fi
  hyperfine \
    --warmup "{{warmup}}" \
    --runs "{{runs}}" \
    --prepare "rm -rf '${out_dir}'" \
    "cargo run --manifest-path ${repo_root}/apps/backend/Cargo.toml -p zksync-lite-sunset-cli -- snapshots-compile --data-dir '${data_dir}' --out-dir '${out_dir}' --snapshot-label '{{snapshot_label}}'"

# Sampled CPU profile of the real-data compile path via Samply
snapshots-profile-samply data_dir="data" out_dir="/tmp/zksync-lite-sunset-samply" snapshot_label="snapshot-samply":
  #!/usr/bin/env bash
  set -euo pipefail
  if ! command -v samply >/dev/null 2>&1; then
    echo "samply is not installed. Install it with: brew install samply" >&2
    exit 1
  fi
  repo_root="$(cd ../.. && pwd)"
  data_dir="{{data_dir}}"
  out_dir="{{out_dir}}"
  if [[ "${data_dir}" != /* ]]; then
    data_dir="${repo_root}/${data_dir}"
  fi
  cargo build --manifest-path Cargo.toml --profile profiling -p zksync-lite-sunset-cli
  samply record -- \
    "./target/profiling/zksync-lite-sunset-cli" \
    snapshots-compile \
    --data-dir "${data_dir}" \
    --out-dir "${out_dir}" \
    --snapshot-label "{{snapshot_label}}"

# Native macOS profile of the real-data compile path via cargo-instruments
snapshots-profile-instruments data_dir="data" snapshot_label="snapshot-instruments" trace_out="/tmp/zksync-lite-sunset-snapshot.trace":
  #!/usr/bin/env bash
  set -euo pipefail
  if ! cargo instruments --help >/dev/null 2>&1; then
    echo "cargo-instruments is not installed. Install it with: cargo install cargo-instruments" >&2
    exit 1
  fi
  repo_root="$(cd ../.. && pwd)"
  data_dir="{{data_dir}}"
  if [[ "${data_dir}" != /* ]]; then
    data_dir="${repo_root}/${data_dir}"
  fi
  cargo instruments \
    --manifest-path Cargo.toml \
    --package zksync-lite-sunset-cli \
    --profile profiling \
    --template time \
    --no-open \
    --output "{{trace_out}}" \
    -- \
    snapshots-compile \
    --data-dir "${data_dir}" \
    --out-dir /tmp/zksync-lite-sunset-instruments \
    --snapshot-label "{{snapshot_label}}"

# Import a compiled snapshot artifact directory into serving tables
snapshots-import-artifacts database_url artifact_dir reset_runtime_state="false":
  #!/usr/bin/env bash
  set -euo pipefail
  repo_root="$(cd ../.. && pwd)"
  artifact_dir="{{artifact_dir}}"
  if [[ "${artifact_dir}" != /* ]]; then
    artifact_dir="${repo_root}/${artifact_dir}"
  fi
  args=(--database-url "{{database_url}}" --artifact-dir "${artifact_dir}")
  if [[ "{{reset_runtime_state}}" == "true" ]]; then
    args+=(--reset-runtime-state)
  fi
  RUST_LOG="${SNAPSHOT_RUST_LOG:-info}" cargo run -p zksync-lite-sunset-cli -- snapshots-import-artifacts "${args[@]}"

# Import raw CSVs and materialize the single snapshot in one pass
claims-import database_url data_dir="data" chunk_size="5000" snapshot_label="snapshot-import" truncate="false":
  #!/usr/bin/env bash
  set -euo pipefail
  args=(--database-url "{{database_url}}" --data-dir "{{data_dir}}" --chunk-size "{{chunk_size}}" --snapshot-label "{{snapshot_label}}")
  if [[ "{{truncate}}" == "true" ]]; then
    args+=(--truncate)
  fi
  cargo run -p zksync-lite-sunset-cli -- claims-import "${args[@]}"

claims-import-refresh database_url data_dir="data" chunk_size="5000" snapshot_label="snapshot-import":
  @just claims-import {{database_url}} {{data_dir}} {{chunk_size}} {{snapshot_label}} true

generate-dev-snapshot address out_dir mode="default":
  @cargo run -p zksync-lite-sunset-cli -- generate-dev-snapshot --address {{address}} --out-dir {{out_dir}} --mode {{mode}}

dev-seed-snapshot database_url address mode="default" snapshot_label="snapshot-dev-seeded-address" out_dir="":
  #!/usr/bin/env bash
  set -euo pipefail
  args=(--database-url "{{database_url}}" --address "{{address}}" --mode "{{mode}}" --snapshot-label "{{snapshot_label}}")
  if [[ -n "{{out_dir}}" ]]; then
    args+=(--out-dir "{{out_dir}}")
  fi
  cargo run -p zksync-lite-sunset-cli -- dev-seed-snapshot "${args[@]}"

db-reset database_url:
  @psql {{database_url}} -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"
  @just db-init {{database_url}}
