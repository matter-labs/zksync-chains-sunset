{
  "name": "zksync-lite-sunset-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "claim",
    "migrate"
  ],
  "scripts": {
    "dev:claim": "cd claim && bun run dev",
    "dev:migrate": "cd migrate && bun run dev",
    "build": "bun run build:claim && bun run build:migrate",
    "build:claim": "cd claim && bun run build",
    "build:migrate": "cd migrate && bun run build",
    "preview:claim": "cd claim && bun run preview",
    "preview:migrate": "cd migrate && bun run preview",
    "typecheck": "bun run typecheck:claim && bun run typecheck:migrate",
    "typecheck:claim": "cd claim && bun run typecheck",
    "typecheck:migrate": "cd migrate && bun run typecheck",
    "test:unit": "bun run test:unit:claim && bun run test:unit:migrate",
    "test:unit:claim": "bun test --preload ./tests/support/unit.setup.ts ./claim/tests",
    "test:unit:migrate": "bun test --preload ./tests/support/unit.setup.ts ./migrate/tests",
    "test:e2e": "playwright test",
    "test:e2e:compose": "PLAYWRIGHT_CLAIM_APP_URL=http://127.0.0.1:4421 PLAYWRIGHT_MIGRATE_APP_URL=http://127.0.0.1:4422 playwright test --config playwright.compose.config.ts",
    "test:e2e:claim": "playwright test tests/e2e/eligibility.spec.ts",
    "test:e2e:migrate": "playwright test tests/e2e/migrations.spec.ts",
    "fmt": "prettier . --write",
    "fmt-check": "prettier . --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "@tanstack/react-query": "^5.95.2",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.0.0",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/tailwind": "^6.0.0",
    "@playwright/test": "^1.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "bun-types": "^1.3.11",
    "jsdom": "^29.0.1",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
