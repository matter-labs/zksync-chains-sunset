# Base URL for the Rust backend API (used by the browser).
#
# In dev, Astro proxies `/api/*` to the backend on `http://localhost:3000`,
# so leaving this empty avoids CORS preflight noise.
PUBLIC_API_BASE_URL=

# Optional explicit cross-links between the split apps.
PUBLIC_CLAIM_APP_URL=
PUBLIC_MIGRATE_APP_URL=

# L1 migration contract address (needed by the migrate widget to read
# on-chain balances and `isTokenMigrated` without hitting the backend).
PUBLIC_MIGRATION_CONTRACT_ADDRESS=

# Show the "Free claim" (sponsored) flow alongside the normal claim. Defaults
# to hidden — set to "true" to expose the sponsored option.
PUBLIC_FREE_CLAIM_ENABLED=

# Address-screening service endpoint called before each claim/migrate transaction.
# Leave empty to skip screening.
PUBLIC_SCREENING_API_URL=
